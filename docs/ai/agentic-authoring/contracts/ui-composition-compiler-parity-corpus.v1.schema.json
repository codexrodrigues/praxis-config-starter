{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://praxisplatform.org/schemas/ai/ui-composition-compiler-parity-corpus.v1.schema.json",
  "title": "Praxis UiCompositionPlan compiler parity and target attestation corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "corpusVersion",
    "kind",
    "canonicalization",
    "compilerContracts",
    "compilerReceipts",
    "targetProfiles",
    "cases"
  ],
  "properties": {
    "schemaVersion": { "const": "praxis.ui-composition-compiler-parity-corpus/v1" },
    "corpusVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "kind": { "const": "praxis.ui-composition-compiler-parity-corpus" },
    "description": { "type": "string", "minLength": 1 },
    "canonicalization": { "$ref": "#/$defs/canonicalization" },
    "compilerContracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["java", "typescript"],
      "properties": {
        "java": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "builderVersion"],
          "properties": {
            "id": { "const": "config-ui-composition-plan-compiler" },
            "builderVersion": { "type": "string", "pattern": "^config-ui-composition-plan-compiler@[0-9]+\\.[0-9]+\\.[0-9]+$" }
          }
        },
        "typescript": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "exportName"],
          "properties": {
            "id": { "const": "praxis-page-builder-ui-composition-plan-compiler" },
            "exportName": { "const": "compileUiCompositionPlan" }
          }
        }
      }
    },
    "compilerReceipts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["java"],
      "properties": {
        "java": { "$ref": "#/$defs/javaCompilerReceipt" }
      }
    },
    "targetProfiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/targetProfile" }
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "canonicalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection", "templateConfig", "diagnostics"],
      "properties": {
        "projection": { "const": "sort-object-keys-preserve-arrays-preserve-null-utf8-sha256" },
        "templateConfig": { "const": "canonical-json-hash-service-v1-sort-keys-omit-null-preserve-arrays-utf8-sha256" },
        "diagnostics": { "const": "stable-code-path-severity-provenance" }
      }
    },
    "targetProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "releaseTrain",
        "registryFingerprint",
        "providerEvidenceRefs",
        "runtimeExecutionReceipt"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "releaseTrain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "commit", "certification", "primaryEvidenceRef"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "certification": { "type": "string", "minLength": 1 },
            "primaryEvidenceRef": { "type": "string", "minLength": 1 }
          }
        },
        "registryFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "providerEvidenceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceRef" }
        },
        "runtimeExecutionReceipt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "producerRevision", "modules"],
          "properties": {
            "scope": { "const": "source-trees-and-built-module-bytes" },
            "producerRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "modules": {
              "type": "object",
              "additionalProperties": false,
              "required": ["core", "table", "list", "tabs", "page-builder"],
              "properties": {
                "core": { "$ref": "#/$defs/runtimeModuleReceipt" },
                "table": { "$ref": "#/$defs/runtimeModuleReceipt" },
                "list": { "$ref": "#/$defs/runtimeModuleReceipt" },
                "tabs": { "$ref": "#/$defs/runtimeModuleReceipt" },
                "page-builder": { "$ref": "#/$defs/runtimeModuleReceipt" }
              }
            }
          }
        }
      }
    },
    "runtimeModuleReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePath", "sourceGitTree", "artifactSha256"],
      "properties": {
        "sourcePath": { "type": "string", "minLength": 1 },
        "sourceGitTree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "artifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "javaCompilerReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "sourcePath", "sourceGitBlob", "artifactPath", "artifactSha256"],
      "properties": {
        "scope": { "const": "source-git-blob-and-compiled-class-bytes" },
        "sourcePath": { "const": "src/main/java/org/praxisplatform/config/ai/authoring/AgenticAuthoringUiCompositionPlanCompiler.java" },
        "sourceGitBlob": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "artifactPath": { "const": "target/classes/org/praxisplatform/config/ai/authoring/AgenticAuthoringUiCompositionPlanCompiler.class" },
        "artifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "templateRevisionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registryKey", "version", "etag", "configSha256"],
      "properties": {
        "registryKey": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "etag": { "type": "string", "minLength": 1 },
        "configSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "runtimeCapabilityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "module", "exportName"],
      "properties": {
        "kind": { "enum": ["module-export", "injector-token"] },
        "module": { "enum": ["page-builder", "core", "table", "list", "tabs"] },
        "exportName": { "type": "string", "minLength": 1 }
      }
    },
    "targetPortRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownerWidgetKey", "ownerComponentId", "componentId", "portId", "direction"],
      "properties": {
        "ownerWidgetKey": { "type": "string", "minLength": 1 },
        "ownerComponentId": { "type": "string", "minLength": 1 },
        "componentId": { "type": "string", "minLength": 1 },
        "portId": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["input", "output"] },
        "nestedPath": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": true
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "caseVersion", "semanticIntent", "input", "expected"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "caseVersion": { "const": "1.0.0" },
        "semanticIntent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decisionKind", "purpose"],
          "properties": {
            "decisionKind": { "const": "ui-composition-materialization" },
            "purpose": { "type": "string", "minLength": 1 }
          }
        },
        "input": { "$ref": "#/$defs/input" },
        "expected": { "$ref": "#/$defs/expected" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan"],
      "dependentRequired": {
        "templateReference": ["templateMaterialization"],
        "templateMaterialization": ["templateReference"]
      },
      "properties": {
        "plan": { "type": "object" },
        "templateReference": { "type": "object" },
        "templateMaterialization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["registryKey", "revision", "configJson"],
          "properties": {
            "registryKey": { "type": "string", "minLength": 1 },
            "revision": { "$ref": "#/$defs/templateRevisionIdentity" },
            "configJson": { "type": "object" }
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compilerParity", "targetAttestation"],
      "allOf": [
        {
          "if": {
            "properties": {
              "compilerParity": {
                "type": "object",
                "properties": { "outcome": { "enum": ["pass", "warning"] } },
                "required": ["outcome"]
              }
            }
          },
          "then": {
            "properties": {
              "targetAttestation": {
                "type": "object",
                "properties": { "outcome": { "enum": ["pass", "block"] } }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "compilerParity": {
                "type": "object",
                "properties": { "outcome": { "const": "block" } },
                "required": ["outcome"]
              }
            }
          },
          "then": {
            "properties": {
              "targetAttestation": {
                "type": "object",
                "properties": {
                  "outcome": { "const": "skipped" },
                  "diagnostics": { "type": "array", "maxItems": 0 },
                  "requirements": {
                    "type": "object",
                    "properties": {
                      "components": { "type": "array", "maxItems": 0 },
                      "ports": { "type": "array", "maxItems": 0 },
                      "capabilities": { "type": "array", "maxItems": 0 },
                      "actions": { "type": "array", "maxItems": 0 }
                    },
                    "not": {
                      "properties": { "templateRevision": {} },
                      "required": ["templateRevision"]
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "compilerParity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["phase", "outcome", "diagnostics"],
          "allOf": [
            {
              "if": {
                "properties": { "outcome": { "enum": ["pass", "warning"] } },
                "required": ["outcome"]
              },
              "then": {
                "properties": {
                  "projectionSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
                },
                "required": ["projectionSha256"]
              }
            }
          ],
          "properties": {
            "phase": { "enum": ["template-attestation", "compiler-parity"] },
            "outcome": { "enum": ["pass", "warning", "block"] },
            "projectionSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "diagnostics": {
              "type": "array",
              "items": { "$ref": "#/$defs/compilerDiagnostic" }
            }
          }
        },
        "targetAttestation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profileId", "outcome", "requirements", "diagnostics"],
          "properties": {
            "profileId": { "type": "string", "minLength": 1 },
            "outcome": { "enum": ["pass", "block", "skipped"] },
            "requirements": { "$ref": "#/$defs/targetRequirements" },
            "diagnostics": {
              "type": "array",
              "items": { "$ref": "#/$defs/targetDiagnostic" }
            }
          }
        }
      }
    },
    "compilerDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalId", "severity", "provenance", "engineCodes", "pathByEngine"],
      "properties": {
        "canonicalId": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["warning", "error"] },
        "provenance": { "enum": ["template-attestation", "compiler"] },
        "engineCodes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["java", "typescript"],
          "properties": {
            "java": { "type": "string", "minLength": 1 },
            "typescript": { "type": "string", "minLength": 1 }
          }
        },
        "pathByEngine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["java", "typescript"],
          "properties": {
            "java": { "type": ["string", "null"] },
            "typescript": { "type": ["string", "null"] }
          }
        }
      }
    },
    "targetRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components", "ports", "capabilities", "actions"],
      "properties": {
        "components": { "$ref": "#/$defs/stringArray" },
        "ports": {
          "type": "array",
          "items": { "$ref": "#/$defs/targetPortRequirement" },
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/runtimeCapabilityRef" },
          "uniqueItems": true
        },
        "actions": { "$ref": "#/$defs/stringArray" },
        "templateRevision": { "$ref": "#/$defs/templateRevisionIdentity" }
      }
    },
    "targetDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "severity", "provenance"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "path": { "type": ["string", "null"] },
        "severity": { "enum": ["warning", "error"] },
        "provenance": { "enum": ["target-registry", "semantic-validator", "template-attestation", "ui-composition-plan-preflight"] }
      }
    }
  }
}
