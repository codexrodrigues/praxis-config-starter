{
  "version": "0.2.0",
  "kind": "praxis.ai-authoring.component-capability-catalog",
  "componentId": "praxis-table",
  "capabilities": [
    {
      "id": "praxis-table.title.rename@0.1.0",
      "changeKind": "rename_or_relabel",
      "triggerTerms": ["renomear", "renomeie", "label", "rotulo", "titulo", "title"],
      "fieldAliases": [],
      "examples": [
        {
          "prompt": "Renomeie a tabela para Resultados da consulta.",
          "intent": "Alterar o titulo visivel da tabela sem trocar fonte de dados.",
          "configHints": ["inputs.title=Resultados da consulta", "preservar columns e resourcePath"]
        }
      ]
    },
    {
      "id": "praxis-table.column.add@0.2.0",
      "changeKind": "column.add",
      "triggerTerms": ["column.add", "add_column"],
      "fieldAliases": [],
      "examples": [
        {
          "prompt": "Adicione a coluna e-mail à tabela e mantenha todas as colunas existentes.",
          "intent": "Introduzir uma nova coluna schema-backed que ainda não existe na configuração da tabela, preservando as colunas atuais.",
          "configHints": [
            "operationId=column.add",
            "effect=append-unique columns[] by field",
            "column.order.set e set_column_order apenas reposicionam uma coluna já existente e exigem uma ordem explícita"
          ]
        }
      ]
    },
    {
      "id": "praxis-table.column.format.currency-brl@0.1.0",
      "changeKind": "set_column_format",
      "triggerTerms": ["formatar", "formate", "formatacao", "moeda", "reais", "brl"],
      "fieldAliases": [
        { "field": "salarioLiquido", "aliases": ["salario liquido", "salarioLiquido", "liquido"] },
        { "field": "salarioBruto", "aliases": ["salario bruto", "salarioBruto", "bruto"] },
        { "field": "totalDescontos", "aliases": ["total de descontos", "total descontos", "descontos"] }
      ],
      "examples": [
        {
          "prompt": "Formate a coluna numerica selecionada como moeda.",
          "intent": "Aplicar formatacao monetaria a uma coluna numerica.",
          "configHints": ["columns.<schemaField>.format=currency", "columns.<schemaField>.currency=<hostCurrency>"]
        }
      ]
    },
    {
      "id": "praxis-table.column.format.date@0.1.0",
      "changeKind": "set_column_format",
      "triggerTerms": ["formato de data", "formatacao de data", "data", "dd/MM/yyyy", "yyyy-MM-dd", "date-time"],
      "fieldAliases": [],
      "examples": [
        {
          "prompt": "Quais formatos de data posso usar em uma coluna da tabela?",
          "intent": "Explicar opcoes confirmadas de formatacao de data sem aplicar mudanca.",
          "configHints": ["columns.<schemaField>.type=date", "columns.<schemaField>.format=dd/MM/yyyy|yyyy-MM-dd|yyyy-MM-dd HH:mm|mediumDate|longDate"]
        },
        {
          "prompt": "Formate Data de Admissao como dd/MM/yyyy.",
          "intent": "Aplicar formatacao de data a uma coluna de data confirmada.",
          "configHints": ["columns.<schemaField>.format=dd/MM/yyyy", "preservar resourcePath e dados originais"]
        }
      ]
    },
    {
      "id": "praxis-table.column.presentation.status@0.1.0",
      "changeKind": "set_column_presentation",
      "triggerTerms": ["status", "ativo", "inativo", "badge", "chip", "icone", "icon", "toggle", "sim nao", "sim/não"],
      "fieldAliases": [
        { "field": "ativo", "aliases": ["ativo", "status", "ativo inativo"] },
        { "field": "status", "aliases": ["status", "situacao", "situação"] }
      ],
      "examples": [
        {
          "prompt": "O que voce sugere de formatacao para a coluna de status?",
          "intent": "Explicar opcoes de apresentacao para status booleano ou categorico sem aplicar mudanca.",
          "configHints": ["columns.<schemaField>.format=active-inactive|custom|Sim|Nao", "columns.<schemaField>.renderer.type=badge|chip|icon|toggle"]
        },
        {
          "prompt": "Mostre Ativo como badge verde e Inativo como badge neutro.",
          "intent": "Aplicar apresentacao visual governada para uma coluna de status.",
          "configHints": ["columns.<schemaField>.renderer.type=badge", "columns.<schemaField>.conditionalRenderers usa Json Logic canonico"]
        }
      ]
    },
    {
      "id": "praxis-table.column.visibility@0.1.0",
      "changeKind": "set_column_visibility",
      "triggerTerms": ["ocultar", "oculte", "esconder", "esconda", "deixe somente", "deixar somente", "somente", "apenas", "mantenha as colunas", "manter colunas"],
      "fieldAliases": [
        { "field": "salarioLiquido", "aliases": ["salario liquido", "salarioLiquido", "liquido"] },
        { "field": "salarioBruto", "aliases": ["salario bruto", "salarioBruto", "bruto"] },
        { "field": "totalDescontos", "aliases": ["total de descontos", "total descontos", "descontos"] }
      ],
      "examples": [
        {
          "prompt": "Oculte a coluna de identificador.",
          "intent": "Esconder coluna mantendo o dado disponivel no dataset.",
          "configHints": ["columns.<schemaField>.visible=false", "nao remover resourcePath nem schema"]
        }
      ]
    },
    {
      "id": "praxis-table.column.order@0.1.0",
      "changeKind": "set_column_order",
      "triggerTerms": ["mover", "mova", "reordenar", "reordene", "primeira", "inicio"],
      "fieldAliases": [
        { "field": "salarioLiquido", "aliases": ["salario liquido", "salarioLiquido", "liquido"] },
        { "field": "salarioBruto", "aliases": ["salario bruto", "salarioBruto", "bruto"] },
        { "field": "totalDescontos", "aliases": ["total de descontos", "total descontos", "descontos"] }
      ],
      "examples": [
        {
          "prompt": "Mova a coluna selecionada para a primeira posicao.",
          "intent": "Reordenar colunas sem alterar contrato de dados.",
          "configHints": ["columns order startsWith <schemaField>", "preservar definicoes das demais colunas"]
        }
      ]
    },
    {
      "id": "praxis-table.export.selected-rows@0.1.0",
      "changeKind": "configure_export",
      "triggerTerms": ["exportar", "exportacao", "exportação", "linhas selecionadas", "selecionadas", "selecionados", "botao exportar", "botão exportar", "acao em massa", "ação em massa", "toolbar"],
      "fieldAliases": [],
      "examples": [
        {
          "prompt": "Habilite exportacao para apenas as linhas selecionadas.",
          "intent": "Permitir que a tabela exporte somente as linhas selecionadas pelo usuario.",
          "configHints": ["selection.enabled=true", "toolbar.actions inclui export", "export.enabled=true", "export.formats inclui csv ou xlsx", "export.general.scope=selected", "export.general.includeHeaders=true"]
        }
      ]
    }
  ]
}
