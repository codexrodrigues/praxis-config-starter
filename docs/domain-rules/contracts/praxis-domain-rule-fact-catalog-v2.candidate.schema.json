{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://praxisplatform.org/schemas/domain-rules/praxis-domain-rule-fact-catalog-v2.schema.json",
  "title": "Candidate: Praxis Domain Rule Fact Catalog v2",
  "description": "G1 candidate. Not registered in runtime; structural profile plus semantic constraints documented in ontology-g1-contracts.md.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "praxis.domain-rule-fact-catalog.v2"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "required": [
    "schemaVersion",
    "operations"
  ],
  "$defs": {
    "stringShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "anyOf": [
            {
              "const": "string"
            },
            {
              "const": [
                "string",
                "null"
              ]
            }
          ]
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64000
        },
        "format": {
          "enum": ["date", "date-time", "praxis-local-date-time", "praxis-local-time", "praxis-duration", "praxis-zone-id", "praxis-decimal"]
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": ["string", "null"],
            "maxLength": 64000
          }
        }
      },
      "required": [
        "type",
        "maxLength"
      ]
    },
    "numberShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "anyOf": [
            {
              "const": "number"
            },
            {
              "const": "integer"
            },
            {
              "const": [
                "number",
                "null"
              ]
            },
            {
              "const": [
                "integer",
                "null"
              ]
            }
          ]
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        }
      },
      "required": [
        "type"
      ]
    },
    "booleanShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "anyOf": [
            {
              "const": "boolean"
            },
            {
              "const": [
                "boolean",
                "null"
              ]
            }
          ]
        }
      },
      "required": [
        "type"
      ]
    },
    "nullShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "null"
        }
      },
      "required": [
        "type"
      ]
    },
    "objectShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "anyOf": [
            {
              "const": "object"
            },
            {
              "const": [
                "object",
                "null"
              ]
            }
          ]
        },
        "properties": {
          "type": "object",
          "maxProperties": 256,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "additionalProperties": {
            "$ref": "#/$defs/shape"
          }
        },
        "required": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "additionalProperties": {
          "anyOf": [
            {
              "const": false
            },
            {
              "$ref": "#/$defs/shape"
            }
          ]
        },
        "maxProperties": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        }
      },
      "required": [
        "type",
        "properties",
        "required",
        "additionalProperties",
        "maxProperties"
      ]
    },
    "arrayShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "anyOf": [
            {
              "const": "array"
            },
            {
              "const": [
                "array",
                "null"
              ]
            }
          ]
        },
        "items": {
          "$ref": "#/$defs/shape"
        },
        "minItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "required": [
        "type",
        "items",
        "minItems",
        "maxItems"
      ]
    },
    "shape": {
      "oneOf": [
        {
          "$ref": "#/$defs/stringShape"
        },
        {
          "$ref": "#/$defs/numberShape"
        },
        {
          "$ref": "#/$defs/booleanShape"
        },
        {
          "$ref": "#/$defs/nullShape"
        },
        {
          "$ref": "#/$defs/objectShape"
        },
        {
          "$ref": "#/$defs/arrayShape"
        }
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaPointer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^#(?:/(?:[^~]|~[01])*)*$"
        },
        "labels": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "propertyNames": {
            "type": "string",
            "minLength": 2,
            "maxLength": 35
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "descriptions": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "propertyNames": {
            "type": "string",
            "minLength": 2,
            "maxLength": 35
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "providerRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "sensitivity": {
          "enum": [
            "NON_SENSITIVE",
            "PERSONAL",
            "SENSITIVE",
            "SECRET"
          ]
        },
        "redaction": {
          "enum": [
            "NONE",
            "MASK",
            "HASH",
            "OMIT"
          ]
        }
      },
      "required": [
        "schemaPointer",
        "labels",
        "descriptions",
        "providerRef",
        "evidenceRefs",
        "sensitivity",
        "redaction"
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operationKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "snapshotSchema": {
          "$ref": "#/$defs/objectShape",
          "properties": {"type": {"const": "object"}}
        },
        "facts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/fact"
          }
        }
      },
      "required": [
        "operationKey",
        "snapshotSchema",
        "facts"
      ]
    }
  }
}
